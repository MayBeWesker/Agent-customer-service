{
  "product_name": "AI用药伴侣",
  "workflow": [
    {
      "step": 1,
      "name": "拍照录药",
      "input": ["药盒照片", "说明书截图", "OCR文本"],
      "output": ["候选药品名称", "规格", "用法用量"]
    },
    {
      "step": 2,
      "name": "信息确认",
      "input": ["识别结果", "用户手动修正", "家属辅助确认"],
      "output": ["可信药品档案"]
    },
    {
      "step": 3,
      "name": "生成计划",
      "input": ["服药频次", "提醒时间", "药品档案"],
      "output": ["电子药箱", "今日提醒计划"]
    },
    {
      "step": 4,
      "name": "提醒记录",
      "input": ["计划时间", "用户状态反馈"],
      "output": ["已服用", "稍后", "漏服", "服药日志"]
    },
    {
      "step": 5,
      "name": "RAG问答",
      "input": ["用户问题", "药品知识库", "电子药箱"],
      "output": ["副作用提醒", "漏服建议", "联合用药提示"]
    }
  ]
}
